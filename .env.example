# Solo desarrollo local. Copiar como .env y elegir valores propios.
POSTGRES_DB=servipronto
POSTGRES_USER=servipronto
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://servipronto:change-this-local-password@postgres:5432/servipronto
API_PORT=3000
ADMIN_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://localhost:3000/api/v1
LOG_LEVEL=info
# Adaptador de desafío telefónico solo para desarrollo/pruebas; sin proveedor real, producción falla de forma segura.
PHONE_VERIFICATION_LOCAL_ENABLED=true
JWT_SECRET=replace-with-at-least-32-random-characters
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-local-password
