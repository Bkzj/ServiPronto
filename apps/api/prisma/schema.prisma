generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model RuntimeProbe {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")

  @@map("runtime_probe")
}

enum AdminStatus {
  ACTIVE
  SUSPENDED
}

model AdminAccount {
  id              String                   @id @default(uuid()) @db.Uuid
  email           String                   @unique @db.VarChar(254)
  passwordHash    String                   @map("password_hash") @db.VarChar(255)
  displayName     String                   @map("display_name") @db.VarChar(120)
  status          AdminStatus              @default(ACTIVE)
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")
  reviewDecisions ProviderReviewDecision[]

  @@map("admin_accounts")
}

enum AppIdentityStatus {
  PENDING_PHONE_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum PhoneVerificationPurpose {
  REGISTRATION
  SESSION
}

model AppIdentity {
  id              String                       @id @default(uuid()) @db.Uuid
  email           String                       @unique @db.VarChar(254)
  passwordHash    String                       @map("password_hash") @db.VarChar(255)
  phone           String                       @unique @db.VarChar(20)
  phoneVerifiedAt DateTime?                    @map("phone_verified_at")
  status          AppIdentityStatus            @default(PENDING_PHONE_VERIFICATION)
  createdAt       DateTime                     @default(now()) @map("created_at")
  updatedAt       DateTime                     @updatedAt @map("updated_at")
  phoneChallenges PhoneVerificationChallenge[]
  clientAccount   ClientAccount?
  providerAccount ProviderAccount?

  @@map("app_identities")
}

model PhoneVerificationChallenge {
  id         String                   @id @default(uuid()) @db.Uuid
  identityId String                   @map("identity_id") @db.Uuid
  purpose    PhoneVerificationPurpose
  codeHash   String                   @map("code_hash") @db.VarChar(255)
  expiresAt  DateTime                 @map("expires_at")
  consumedAt DateTime?                @map("consumed_at")
  attempts   Int                      @default(0)
  createdAt  DateTime                 @default(now()) @map("created_at")
  identity   AppIdentity              @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId, purpose, expiresAt])
  @@map("phone_verification_challenges")
}

model ClientAccount {
  id         String      @id @default(uuid()) @db.Uuid
  identityId String      @unique @map("identity_id") @db.Uuid
  firstName  String?     @map("first_name") @db.VarChar(120)
  lastName   String?     @map("last_name") @db.VarChar(120)
  birthDate  DateTime?   @map("birth_date") @db.Date
  address    Json?
  isComplete Boolean     @default(false) @map("is_complete")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  identity   AppIdentity @relation(fields: [identityId], references: [id], onDelete: Restrict)

  @@map("client_accounts")
}

enum ProviderAccountStatus {
  INCOMPLETE
  IN_REVIEW
  CHANGES_REQUIRED
  APPROVED
  REJECTED
  SUSPENDED
}

model ProviderAccount {
  id                  String                   @id @default(uuid()) @db.Uuid
  identityId          String                   @unique @map("identity_id") @db.Uuid
  status              ProviderAccountStatus    @default(INCOMPLETE)
  firstName           String?                  @map("first_name") @db.VarChar(120)
  lastName            String?                  @map("last_name") @db.VarChar(120)
  initialCategoryId   String?                  @map("initial_category_id") @db.Uuid
  tasks               String[]                 @default([])
  taskClarification   String?                  @map("task_clarification") @db.Text
  modality            String?                  @db.VarChar(40)
  coverage            Json?
  availability        String?                  @db.Text
  experience          String?                  @db.Text
  indicativePrice     Decimal?                 @map("indicative_price") @db.Decimal(12, 2)
  hourlyRate          Decimal?                 @map("hourly_rate") @db.Decimal(12, 2)
  declaredCredential  String?                  @map("declared_credential") @db.Text
  submittedAt         DateTime?                @map("submitted_at")
  presentationVersion Int                      @default(0) @map("presentation_version")
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")
  identity            AppIdentity              @relation(fields: [identityId], references: [id], onDelete: Restrict)
  initialCategory     ServiceCategory?         @relation(fields: [initialCategoryId], references: [id], onDelete: Restrict)
  presentations       ProviderPresentation[]
  reviewDecisions     ProviderReviewDecision[]

  @@index([status, submittedAt])
  @@map("provider_accounts")
}

model ProviderPresentation {
  id                 String                   @id @default(uuid()) @db.Uuid
  providerId         String                   @map("provider_id") @db.Uuid
  version            Int
  submittedAt        DateTime                 @default(now()) @map("submitted_at")
  contactEmail       String                   @map("contact_email") @db.VarChar(254)
  verifiedPhone      String                   @map("verified_phone") @db.VarChar(20)
  firstName          String                   @map("first_name") @db.VarChar(120)
  lastName           String                   @map("last_name") @db.VarChar(120)
  initialCategoryId  String                   @map("initial_category_id") @db.Uuid
  categorySlug       String                   @map("category_slug") @db.VarChar(120)
  categoryName       String                   @map("category_name") @db.VarChar(120)
  tasks              String[]
  taskClarification  String?                  @map("task_clarification") @db.Text
  modality           String                   @db.VarChar(40)
  coverage           Json
  availability       String                   @db.Text
  experience         String                   @db.Text
  indicativePrice    Decimal?                 @map("indicative_price") @db.Decimal(12, 2)
  hourlyRate         Decimal?                 @map("hourly_rate") @db.Decimal(12, 2)
  declaredCredential String?                  @map("declared_credential") @db.Text
  provider           ProviderAccount          @relation(fields: [providerId], references: [id], onDelete: Restrict)
  initialCategory    ServiceCategory          @relation(fields: [initialCategoryId], references: [id], onDelete: Restrict)
  reviewDecisions    ProviderReviewDecision[]

  @@unique([providerId, version])
  @@unique([id, providerId])
  @@map("provider_presentations")
}

model ProviderReviewDecision {
  id              String                @id @default(uuid()) @db.Uuid
  providerId      String                @map("provider_id") @db.Uuid
  presentationId  String                @map("presentation_id") @db.Uuid
  adminId         String                @map("admin_id") @db.Uuid
  previousStatus  ProviderAccountStatus @map("previous_status")
  resultingStatus ProviderAccountStatus @map("resulting_status")
  reason          String?               @db.Text
  createdAt       DateTime              @default(now()) @map("created_at")
  provider        ProviderAccount       @relation(fields: [providerId], references: [id], onDelete: Restrict)
  presentation    ProviderPresentation  @relation(fields: [presentationId, providerId], references: [id, providerId], onDelete: Restrict)
  admin           AdminAccount          @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([presentationId])
  @@index([providerId, createdAt])
  @@index([adminId, createdAt])
  @@map("provider_review_decisions")
}

model ServiceCategory {
  id               String                 @id @default(uuid()) @db.Uuid
  name             String                 @db.VarChar(120)
  slug             String                 @unique @db.VarChar(120)
  enabled          Boolean                @default(false)
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  initialProviders ProviderAccount[]
  presentations    ProviderPresentation[]

  @@map("service_categories")
}
